{
  "name": "controle-run",
  "version": "0.2.0",
  "private": true,
  "description": "Gerenciador desktop local-first de projetos PM2 e GitHub Actions Runners",
  "author": "Controle Run",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "tsc --noEmit && electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "package:win": "npm run build && electron-builder --win nsis"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "pm2": "^6.0.8",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "br.com.controlerun.app",
    "productName": "Controle Run",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/pm2/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
